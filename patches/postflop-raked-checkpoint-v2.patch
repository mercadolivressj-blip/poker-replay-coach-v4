+
+fn f32_bytes(v: &[f32]) -> &[u8] {
+    unsafe { slice::from_raw_parts(v.as_ptr().cast::<u8>(), std::mem::size_of_val(v)) }
+}
+
+fn f32_bytes_mut(v: &mut [f32]) -> &mut [u8] {
+    unsafe { slice::from_raw_parts_mut(v.as_mut_ptr().cast::<u8>(), std::mem::size_of_val(v)) }
+}
+
+fn i16_bytes(v: &[i16]) -> &[u8] {
+    unsafe { slice::from_raw_parts(v.as_ptr().cast::<u8>(), std::mem::size_of_val(v)) }
+}
+
+fn i16_bytes_mut(v: &mut [i16]) -> &mut [u8] {
+    unsafe { slice::from_raw_parts_mut(v.as_mut_ptr().cast::<u8>(), std::mem::size_of_val(v)) }
+}
+
+fn write_array(w: &mut impl Write, a: &Array) -> io::Result<()> {
+    match a {
+        Array::F32(v) => w.write_all(f32_bytes(v)),
+        Array::I16 { data, scales } => {
+            w.write_all(i16_bytes(data))?;
+            w.write_all(f32_bytes(scales))
+        }
+    }
+}
+
+fn read_array(r: &mut impl Read, a: &mut Array) -> io::Result<()> {
+    match a {
+        Array::F32(v) => r.read_exact(f32_bytes_mut(v)),
+        Array::I16 { data, scales } => {
+            r.read_exact(i16_bytes_mut(data))?;
+            r.read_exact(f32_bytes_mut(scales))
+        }
+    }
+}
+
+fn checkpoint_shape_fingerprint(offsets: &[u32], sizes: &[u32]) -> u64 {
+    let mut h = FNV_OFFSET;
+    for &v in offsets.iter().chain(sizes.iter()) {
+        for b in v.to_le_bytes() {
+            h ^= b as u64;
+            h = h.wrapping_mul(FNV_PRIME);
+        }
+    }
+    h
+}
