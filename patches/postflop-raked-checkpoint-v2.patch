+const CHECKPOINT_MAGIC: [u8; 8] = *b"PFCFRCP1";
+const CHECKPOINT_VERSION: u32 = 1;
+const CHECKPOINT_ENDIAN: u32 = 0x0102_0304;
+const FNV_OFFSET: u64 = 0xcbf29ce484222325;
+const FNV_PRIME: u64 = 0x00000100000001B3;
