+fn checkpoint_config_fingerprint(cfg: &SolveConfig) -> Result<u64, String> {
+    // max_iterations and target_exploitability are stopping knobs, not game/DCFR
+    // semantics, so a checkpoint can safely resume with a larger ceiling or a tighter
+    // target. Every strategic knob (ranges, board, stacks, rake, sizings, DCFR params,
+    // locks, etc.) remains in the fingerprint.
+    let mut stable = cfg.clone();
+    stable.max_iterations = 0;
+    stable.target_exploitability = 0.0;
+    let text = toml::to_string(&stable).map_err(|e| format!("checkpoint config serialization failed: {e}"))?;
+    let mut h = 0xcbf29ce484222325u64;
+    for b in text.as_bytes() {
+        h ^= *b as u64;
+        h = h.wrapping_mul(0x00000100000001B3u64);
+    }
+    Ok(h)
+}
