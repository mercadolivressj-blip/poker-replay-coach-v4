diff --git a/engine/src/nlhe.rs b/engine/src/nlhe.rs
--- a/engine/src/nlhe.rs
+++ b/engine/src/nlhe.rs
@@ -777,6 +777,8 @@
     fn zero_sum(&self) -> bool {
-        // An ICM spot is general-sum: the frozen field trades equity with the pair
-        // whenever chips move, by a different amount at every terminal and not always
-        // in the same direction. See the module docs.
-        self.icm.is_none()
+        // Rake makes terminal utility sums depend on the terminal pot, so a raked
+        // cash game is not zero-sum for best-response accounting. Returning false
+        // makes br::exploitability report NashConv (the sum of unilateral gains)
+        // instead of the rake-shifted BR-value sum that can become negative.
+        // ICM is also general-sum for the reasons documented above.
+        self.icm.is_none() && self.cfg.rake.percent == 0.0
     }
diff --git a/cli/src/solve.rs b/cli/src/solve.rs
--- a/cli/src/solve.rs
+++ b/cli/src/solve.rs
@@ -154,7 +154,8 @@
-    // Under a tournament payoff map the headline metric is NashConv in CSTE chips,
-    // not exploitability in chips: the game is general-sum. Same number, different
-    // meaning, so it never wears the chip label.
-    let (metric, unit) = match cfg.tournament {
-        None => ("exploitability", "chips"),
-        Some(_) => ("NashConv", "cste chips"),
+    // Rake and tournament payoffs both make the game non-zero-sum for best-response
+    // accounting. In those domains the correct convergence metric is NashConv: the
+    // sum of both players' unilateral gains against the current profile.
+    let (metric, unit) = match (&cfg.tournament, cfg.rake.percent > 0.0) {
+        (None, false) => ("exploitability", "chips"),
+        (None, true) => ("NashConv", "chips"),
+        (Some(_), _) => ("NashConv", "cste chips"),
     };
